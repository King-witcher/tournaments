# Copie para .env (no banco local o usuário tournaments entra sem senha; ver README).
DATABASE_URL=postgres://tournaments@localhost:5432/tournaments
API_ADDR=127.0.0.1:4000
WEB_ORIGIN=http://localhost:4001
RUST_LOG=info,api=debug,tower_http=debug
REDIS_URL=redis://127.0.0.1:6379/1

# Prefixo das chaves, para separar ambientes deste projeto no database 0 (padrão tournaments:)
# REDIS_PREFIX=tournaments:

# RESEND_API_KEY=

# Login com Discord (opcional: sem client id/secret a API sobe e o login responde 503)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback
# Cookie de sessão; em produção COOKIE_DOMAIN=.dominio e COOKIE_SECURE=true
# COOKIE_DOMAIN=
# COOKIE_SECURE=false

# Web Push (opcional: sem as duas chaves a API sobe e os avisos só chegam com o site aberto).
# Gere com `bun scripts/vapid-keys.ts` em backend/.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contato da assinatura VAPID (mailto: ou https:); padrão: WEB_ORIGIN
# VAPID_SUBJECT=mailto:voce@exemplo.com
