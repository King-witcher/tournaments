# Copie para .env. Linha ativa é obrigatória; comentada é opcional e mostra o
# padrão (ou um exemplo, quando não há padrão). Variável vazia conta como ausente.

# --- Banco e Redis ---
# No banco local o usuário tournaments entra sem senha (ver README).
DATABASE_URL=postgres://tournaments@localhost:5432/tournaments
# Localmente, sempre o database 1 (os outros são de outros projetos).
REDIS_URL=redis://127.0.0.1:6379/1
# Prefixo das chaves, para separar ambientes deste projeto no mesmo database.
# REDIS_PREFIX=tournaments:

# --- Servidor ---
# API_ADDR=127.0.0.1:4000
# Origem do front, liberada no CORS.
# WEB_ORIGIN=http://localhost:4001
# Acrescente tower_http=debug para logar cada requisição.
# RUST_LOG=info,api=debug

# --- Cookie de sessão ---
# Em produção: COOKIE_DOMAIN=.dominio e COOKIE_SECURE=true.
# COOKIE_DOMAIN=
# COOKIE_SECURE=false

# --- Login com Discord ---
# Sem client id e secret, a API sobe e o login com Discord responde 503.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback

# --- Login com Google ---
# Sem client id e secret, a API sobe e o login com Google responde 503. O
# client de hoje só aceita o redirect de produção (ver README).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Email (Resend) ---
# Cadastro, recuperação de senha e troca de email. Sem os dois, os emails (com o
# link) vão para o log; com COOKIE_SECURE=true, a API não sobe sem eles.
# RESEND_API_KEY=
# EMAIL_FROM=Torneios <nao-responda@magic3t.com.br>
# Teto de envios por dia, abaixo dos 100 do plano grátis.
# EMAIL_DAILY_LIMIT=90

# --- Web Push ---
# Sem as duas chaves, a API sobe e os avisos só chegam com o site aberto.
# Gere com `bun scripts/vapid-keys.ts` em backend/.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contato da assinatura VAPID (mailto: ou https:); padrão: WEB_ORIGIN.
# VAPID_SUBJECT=mailto:voce@exemplo.com

# Bucket dos prints do placar (opcional: sem as três primeiras a API sobe e os prints
# somem da interface; só parte delas impede a API de subir). Localmente, deixe sem: o
# bucket é o de produção. Como criar: README,
# "Bucket dos prints".
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Região do bucket (padrão us-east-1)
# S3_REGION=us-east-1
# Só para outro S3 compatível (R2, MinIO), com o bucket no caminho: http://127.0.0.1:9000
# S3_ENDPOINT=
