  "db_name": "PostgreSQL",
  "query": "select p.id, p.user_id, m.nickname, u.avatar_url, p.seed as \"seed!\",\n                  p.withdrawn_at is not null as \"withdrawn!\", m.left_at is not null as \"left!\"\n           from participants p\n           join tenant_members m on m.tenant_id = p.tenant_id and m.user_id = p.user_id\n           join users u on u.id = p.user_id\n           where p.tournament_id = $1 and p.seed is not null\n           order by p.seed",
