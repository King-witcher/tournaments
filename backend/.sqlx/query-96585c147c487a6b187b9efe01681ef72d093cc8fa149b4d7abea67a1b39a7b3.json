  "query": "select id, notice as \"notice: Json<Value>\", created_at,\n                  read_at is not null as \"read!\"\n           from notifications\n           where user_id = $1\n             and ($2::bool is null or (read_at is not null) = $2)\n             and ($3::bigint is null or id < $3)\n           order by id desc\n           limit $4",
