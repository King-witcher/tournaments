  "query": "select t.id, t.seed, bool_and(p.checked_in_at is not null) as \"checked_in!\",\n                  count(*) as \"players!\"\n           from teams t\n           join participants p on p.tournament_id = t.tournament_id and p.team_id = t.id\n           where t.tournament_id = $1\n           group by t.id\n           order by t.created_at, t.id",
