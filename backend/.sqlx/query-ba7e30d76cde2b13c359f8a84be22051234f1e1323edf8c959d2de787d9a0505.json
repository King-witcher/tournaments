  "query": "select t.id, t.slug, t.name, t.description, m.role, m.nickname, t.deletion_due_at, t.logo_key\n           from tenants t\n           join tenant_members m on m.tenant_id = t.id\n           where t.slug = $1 and m.user_id = $2 and m.left_at is null",
