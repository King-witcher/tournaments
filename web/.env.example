# Copie para .env.local. Comentada é opcional e mostra o padrão.

# URL da API. Entra no código no build (NEXT_PUBLIC_): em produção, defina antes
# do `bun run build`.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Client id público do Discord e do Google, para o botão de entrar ir direto ao
# provedor (sem passar pela API). Os mesmos DISCORD_CLIENT_ID e
# GOOGLE_CLIENT_ID da API, que troca o code: se forem diferentes, o login falha
# na volta. Sem um deles, o botão daquele provedor diz que o login não está
# configurado. Entram no código no build, como a URL da API.
# NEXT_PUBLIC_DISCORD_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
